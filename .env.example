# ═════════════════════════════════════════════════════════════════════
#  IMPORTANTE: este archivo es SOLO una plantilla y la app NO lo lee.
#  Copialo como `.env.local` (mismo directorio) y completá los valores ahí.
#  Después de cualquier cambio en .env.local hay que REINICIAR el servidor
#  (Ctrl+C y de nuevo `npm run dev`).
# ═════════════════════════════════════════════════════════════════════

# ── Supabase (datos y archivos) ──────────────────────────────────────
# Crear un proyecto gratuito en https://supabase.com y copiar estos valores
# desde  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key (¡secreta! solo vive en el servidor, nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Acceso al panel de administración ────────────────────────────────
# Login simple con usuario y contraseña (sin Supabase Auth).
ADMIN_USERNAME=name
ADMIN_PASSWORD=elegi-una-contrasena-larga-y-segura
# Opcional: secreto para firmar la cookie de sesión (si no está, se deriva
# de la contraseña). Cambiarlo invalida las sesiones abiertas.
# ADMIN_SECRET=un-secreto-aleatorio-largo

# ── Sitio ────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra final). En Vercel: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
